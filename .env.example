# Copy this file to .env and fill in real values. Never commit .env.

# Proxmox API base URL (no trailing slash)
PROXMOX_URL=https://proxmox.example.local:8006

# Read-only Proxmox API token, format: user@realm!token-id=secret
PROXMOX_TOKEN=apiuser@pve!homelab-api=00000000-0000-0000-0000-000000000000
